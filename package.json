{
  "name": "evidence-research-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.report.config.ts",
    "test": "vitest run",
    "render-charts": "node tools/render-charts.mjs",
    "format": "prettier --write apps packages tools/*.mjs *.ts",
    "format:check": "prettier --check apps packages tools/*.mjs *.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@resvg/resvg-js": "^2.6.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
