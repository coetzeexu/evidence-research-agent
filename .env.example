# Copy to .env. Credentials stay server-side; .env is ignored by git.
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Optional gateway routing header (e.g. maas); leave empty for direct providers.
LLM_PLATFORM=
# Optional vLLM chat template switch: true/false. Empty leaves provider defaults.
LLM_VLLM_THINKING=
RESEARCH_DATA_DIR=.research-data
RESEARCH_HOST=127.0.0.1
RESEARCH_PORT=8000
